################################################################################
# Mantl AWS EKS - Example Configuration
# Copy this file to terraform.tfvars and customize for your environment
################################################################################

# General
cluster_name       = "mantl-prod"
region             = "us-east-1"
kubernetes_version = "1.29"

tags = {
  Environment = "production"
  Project     = "mantl"
  Team        = "platform"
  CostCenter  = "infrastructure"
}

# VPC
vpc_cidr           = "10.0.0.0/16"
single_nat_gateway = false  # Set to true for non-prod to save costs

# Cluster Access
cluster_endpoint_public_access = true  # Set to false for private-only access

# System Node Group (for platform components)
system_node_instance_types = ["m6i.large", "m5.large"]
system_node_min_size       = 2
system_node_max_size       = 4
system_node_desired_size   = 2

# Workload Node Group (for applications)
workload_node_instance_types = ["m6i.xlarge", "m5.xlarge"]
workload_node_capacity_type  = "ON_DEMAND"  # Use "SPOT" for cost savings
workload_node_min_size       = 2
workload_node_max_size       = 10
workload_node_desired_size   = 3

# Route53 Zones for External DNS and cert-manager
# Replace with your hosted zone ARNs
route53_zone_arns = [
  "arn:aws:route53:::hostedzone/Z1234567890ABC",
]

# Secrets for External Secrets Operator
# Replace with your secret ARNs or use wildcards
ssm_parameter_arns = [
  "arn:aws:ssm:us-east-1:123456789012:parameter/mantl/*",
]

secrets_manager_arns = [
  "arn:aws:secretsmanager:us-east-1:123456789012:secret:mantl/*",
]
