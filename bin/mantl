#!/usr/bin/env bash
set -euo pipefail

# Mantl CLI - Command-line interface for Mantl Platform
# Version: 1.0.0

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Configuration
MANTL_ROOT="${MANTL_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
VERSION="1.0.0"

# Helper functions
log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1"; }

show_version() {
    echo "mantl version $VERSION"
}

show_help() {
    cat << EOF
${CYAN}Mantl CLI${NC} - Kubernetes Platform Management Tool

${YELLOW}Usage:${NC}
    mantl <command> [options]

${YELLOW}Commands:${NC}

  ${GREEN}Setup & Installation:${NC}
    init                 Initialize new Mantl platform
    wizard               Run interactive setup wizard
    install              Install platform components

  ${GREEN}Cluster Management:${NC}
    status               Show platform status
    health               Check cluster health
    info                 Display cluster information
    nodes                List cluster nodes
    contexts             List available kubectl contexts

  ${GREEN}Application Management:${NC}
    deploy <app>         Deploy an application
    delete <app>         Delete an application
    list                 List deployed applications
    sync <app>           Sync application with ArgoCD
    logs <app>           View application logs

  ${GREEN}Dashboards:${NC}
    dashboard [name]     Open dashboard (argocd|grafana|prometheus|tempo)
    dashboards           Open all dashboards

  ${GREEN}Observability:${NC}
    metrics              View Prometheus metrics
    traces               View distributed traces
    alerts               View active alerts

  ${GREEN}Utilities:${NC}
    config               Show current configuration
    validate             Validate all manifests
    test                 Run platform tests
    clean                Clean up resources
    version              Show CLI version
    help                 Show this help message

${YELLOW}Examples:${NC}
    mantl init                              # Initialize platform
    mantl deploy api-service                # Deploy API service
    mantl dashboard grafana                 # Open Grafana
    mantl status                            # Show platform status
    mantl logs api-service                  # View application logs

${YELLOW}Environment Variables:${NC}
    MANTL_ROOT           Path to Mantl repository (auto-detected)
    MANTL_ENVIRONMENT    Target environment (dev|staging|production)

For more information, visit: https://github.com/thomasvincent/mantl

EOF
}

cmd_init() {
    log_info "Initializing Mantl platform..."

    if [ -f "$MANTL_ROOT/scripts/setup-wizard.sh" ]; then
        "$MANTL_ROOT/scripts/setup-wizard.sh"
    else
        log_error "Setup wizard not found"
        exit 1
    fi
}

cmd_wizard() {
    cmd_init
}

cmd_install() {
    local env="${1:-dev}"
    log_info "Installing $env environment..."

    cd "$MANTL_ROOT"
    make "install-$env"
}

cmd_status() {
    log_info "Platform Status:"
    echo ""

    # ArgoCD Applications
    echo -e "${CYAN}ArgoCD Applications:${NC}"
    kubectl get applications -n argocd 2>/dev/null || log_warn "ArgoCD not installed"
    echo ""

    # Nodes
    echo -e "${CYAN}Cluster Nodes:${NC}"
    kubectl get nodes 2>/dev/null || log_warn "No cluster found"
    echo ""

    # Namespaces
    echo -e "${CYAN}Platform Namespaces:${NC}"
    kubectl get ns | grep -E "argocd|monitoring|observability|kyverno|cert-manager|external-secrets" || true
}

cmd_health() {
    log_info "Checking cluster health..."
    echo ""

    # Component health
    local components=(
        "argocd:argocd-server"
        "cert-manager:cert-manager"
        "kyverno:kyverno"
        "monitoring:prometheus-prometheus"
    )

    for component in "${components[@]}"; do
        IFS=':' read -r ns name <<< "$component"
        if kubectl get deployment "$name" -n "$ns" &>/dev/null; then
            if kubectl wait --for=condition=available --timeout=5s deployment/"$name" -n "$ns" &>/dev/null; then
                echo -e "${GREEN}✓${NC} $ns/$name"
            else
                echo -e "${RED}✗${NC} $ns/$name (not ready)"
            fi
        else
            echo -e "${YELLOW}⚠${NC} $ns/$name (not installed)"
        fi
    done
}

cmd_info() {
    echo -e "${CYAN}Cluster Information:${NC}"
    echo ""
    kubectl cluster-info
    echo ""
    echo -e "${CYAN}Kubernetes Version:${NC}"
    kubectl version --short
}

cmd_nodes() {
    kubectl get nodes -o wide
}

cmd_contexts() {
    echo -e "${CYAN}Available Contexts:${NC}"
    kubectl config get-contexts
}

cmd_deploy() {
    local app="${1:-}"

    if [ -z "$app" ]; then
        log_error "Application name required"
        echo "Usage: mantl deploy <app-name>"
        exit 1
    fi

    log_info "Deploying $app..."

    # Try to find app in examples
    if [ -d "$MANTL_ROOT/apps/examples/$app" ]; then
        kubectl apply -k "$MANTL_ROOT/apps/examples/$app/base"
        log_success "$app deployed"
    else
        log_error "Application not found: $app"
        echo ""
        echo "Available applications:"
        ls -1 "$MANTL_ROOT/apps/examples/" 2>/dev/null || true
        exit 1
    fi
}

cmd_delete() {
    local app="${1:-}"

    if [ -z "$app" ]; then
        log_error "Application name required"
        exit 1
    fi

    log_warn "Deleting $app..."

    if [ -d "$MANTL_ROOT/apps/examples/$app" ]; then
        kubectl delete -k "$MANTL_ROOT/apps/examples/$app/base" --ignore-not-found
        log_success "$app deleted"
    else
        log_error "Application not found: $app"
        exit 1
    fi
}

cmd_list() {
    echo -e "${CYAN}Deployed Applications:${NC}"
    kubectl get applications -n argocd 2>/dev/null || log_warn "ArgoCD not installed"
    echo ""
    echo -e "${CYAN}All Deployments:${NC}"
    kubectl get deployments --all-namespaces
}

cmd_sync() {
    local app="${1:-}"

    if [ -z "$app" ]; then
        log_error "Application name required"
        exit 1
    fi

    log_info "Syncing $app with ArgoCD..."
    kubectl patch application "$app" -n argocd --type merge -p '{"operation":{"sync":{}}}'
    log_success "$app sync triggered"
}

cmd_logs() {
    local app="${1:-}"

    if [ -z "$app" ]; then
        log_error "Application name required"
        exit 1
    fi

    log_info "Tailing logs for $app..."
    kubectl logs -l "app.kubernetes.io/name=$app" -f --max-log-requests=10
}

cmd_dashboard() {
    local name="${1:-all}"

    case "$name" in
        argocd)
            log_info "Opening ArgoCD at http://localhost:8080"
            kubectl port-forward svc/argocd-server -n argocd 8080:443 &
            sleep 2
            command -v open &>/dev/null && open https://localhost:8080
            ;;
        grafana)
            log_info "Opening Grafana at http://localhost:3000"
            kubectl port-forward svc/prometheus-grafana -n monitoring 3000:80 &
            sleep 2
            command -v open &>/dev/null && open http://localhost:3000
            ;;
        prometheus)
            log_info "Opening Prometheus at http://localhost:9090"
            kubectl port-forward svc/prometheus-prometheus -n monitoring 9090:9090 &
            sleep 2
            command -v open &>/dev/null && open http://localhost:9090
            ;;
        tempo)
            log_info "Opening Tempo (via Grafana Explore)"
            kubectl port-forward svc/prometheus-grafana -n monitoring 3000:80 &
            sleep 2
            command -v open &>/dev/null && open http://localhost:3000/explore
            ;;
        all|*)
            log_info "Opening all dashboards..."
            kubectl port-forward svc/argocd-server -n argocd 8080:443 &>/dev/null &
            kubectl port-forward svc/prometheus-grafana -n monitoring 3000:80 &>/dev/null &
            kubectl port-forward svc/prometheus-prometheus -n monitoring 9090:9090 &>/dev/null &

            echo ""
            echo -e "${CYAN}Dashboards:${NC}"
            echo -e "  ArgoCD:     ${BLUE}https://localhost:8080${NC}"
            echo -e "  Grafana:    ${BLUE}http://localhost:3000${NC}"
            echo -e "  Prometheus: ${BLUE}http://localhost:9090${NC}"
            echo ""
            log_success "Port forwards running in background"
            ;;
    esac
}

cmd_dashboards() {
    cmd_dashboard all
}

cmd_metrics() {
    log_info "Opening Prometheus..."
    cmd_dashboard prometheus
}

cmd_traces() {
    log_info "Opening Tempo via Grafana..."
    cmd_dashboard tempo
}

cmd_alerts() {
    log_info "Fetching active alerts..."
    kubectl port-forward svc/prometheus-prometheus -n monitoring 9090:9090 &>/dev/null &
    local pid=$!
    sleep 2

    curl -s http://localhost:9090/api/v1/alerts | jq -r '.data.alerts[] | "\(.labels.alertname): \(.state)"' 2>/dev/null || \
        log_warn "Could not fetch alerts. Is Prometheus running?"

    kill $pid 2>/dev/null || true
}

cmd_config() {
    echo -e "${CYAN}Mantl Configuration:${NC}"
    echo ""
    echo -e "${YELLOW}Root:${NC}         $MANTL_ROOT"
    echo -e "${YELLOW}Environment:${NC}  ${MANTL_ENVIRONMENT:-not set}"
    echo -e "${YELLOW}Context:${NC}      $(kubectl config current-context 2>/dev/null || echo 'none')"
    echo ""

    if [ -f "/tmp/mantl-config.env" ]; then
        echo -e "${CYAN}Last Wizard Configuration:${NC}"
        cat /tmp/mantl-config.env
    fi
}

cmd_validate() {
    log_info "Validating manifests..."

    cd "$MANTL_ROOT"

    # Validate Kustomize
    log_info "Validating Kustomize builds..."
    find . -name kustomization.yaml -exec dirname {} \; | while read -r dir; do
        if kustomize build "$dir" > /dev/null 2>&1; then
            echo -e "${GREEN}✓${NC} $dir"
        else
            echo -e "${RED}✗${NC} $dir"
        fi
    done

    log_success "Validation complete"
}

cmd_test() {
    cd "$MANTL_ROOT"
    make test
}

cmd_clean() {
    log_warn "This will delete the kind cluster and clean up resources."
    read -p "Continue? (y/N): " -n 1 -r
    echo

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        cd "$MANTL_ROOT"
        make clean
        log_success "Cleanup complete"
    else
        log_info "Cancelled"
    fi
}

# Main command router
main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        init)           cmd_init "$@" ;;
        wizard)         cmd_wizard "$@" ;;
        install)        cmd_install "$@" ;;
        status)         cmd_status "$@" ;;
        health)         cmd_health "$@" ;;
        info)           cmd_info "$@" ;;
        nodes)          cmd_nodes "$@" ;;
        contexts)       cmd_contexts "$@" ;;
        deploy)         cmd_deploy "$@" ;;
        delete)         cmd_delete "$@" ;;
        list)           cmd_list "$@" ;;
        sync)           cmd_sync "$@" ;;
        logs)           cmd_logs "$@" ;;
        dashboard)      cmd_dashboard "$@" ;;
        dashboards)     cmd_dashboards "$@" ;;
        metrics)        cmd_metrics "$@" ;;
        traces)         cmd_traces "$@" ;;
        alerts)         cmd_alerts "$@" ;;
        config)         cmd_config "$@" ;;
        validate)       cmd_validate "$@" ;;
        test)           cmd_test "$@" ;;
        clean)          cmd_clean "$@" ;;
        version)        show_version ;;
        help|--help|-h) show_help ;;
        *)
            log_error "Unknown command: $cmd"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Run main
main "$@"
