// Template: configure the application image and reviewed GitOps repository.
// Registry credentials belong to the Jenkins worker; manifest changes are artifacts.
node {
    env.IMAGE = "your-registry/your-app:${env.BUILD_NUMBER}"
    stage('Checkout') {
        checkout scm
    }
    stage('Test') {
        sh 'mise exec -- make go-test'
    }
    stage('Build Image') {
        sh 'docker build -t "$IMAGE" .'
    }
    stage('Push Image') {
        sh 'docker push "$IMAGE"'
    }
    stage('Prepare GitOps change for review') {
        sh '''
            set -eu
            : "${GITOPS_REPOSITORY:?Set the reviewed GitOps repository URL}"
            git clone -- "$GITOPS_REPOSITORY" gitops
            cd gitops/overlays/staging
            mise exec -- kustomize edit set image "$IMAGE"
        '''
        archiveArtifacts artifacts: 'gitops/overlays/staging/kustomization.yaml'
    }
}
