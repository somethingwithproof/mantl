pipeline {
  agent any
  environment {
    IMAGE = "your-registry/your-app:${env.BUILD_NUMBER}"
  }
  stages {
    stage('Build') {
      steps { sh 'echo build && mkdir -p build && echo ok > build/result.txt' }
    }
    stage('Test') {
      steps { sh 'pytest -q || true' }
    }
    stage('Build Image') {
      steps { sh 'docker build -t ${IMAGE} .' }
    }
    stage('Push Image') {
      steps { sh 'docker push ${IMAGE}' }
    }
    stage('Publish artifacts for Spinnaker (Jenkins trigger)') {
      steps {
        writeFile file: 'build/build.properties', text: "IMAGE=${IMAGE}\n"
        archiveArtifacts artifacts: 'build/build.properties', fingerprint: true
      }
    }
    stage('Trigger Spinnaker via Gate webhook (optional)') {
      when { expression { return false } } // set to true to use webhook
      steps {
        sh 'curl -X POST -H "Content-Type: application/json" \
        -d "{\\"artifacts\\":[{\\"type\\":\\"docker/image\\",\\"name\\":\\"${IMAGE}\\"}], \
            \\\"parameters\\\":{\\\"deployEnv\\\":\\\"staging\\\"}}" \
        https://GATE_URL_OR_INGRESS/webhooks/webhook/YOUR_WEBHOOK_NAME'
      }
    }
  }
}
