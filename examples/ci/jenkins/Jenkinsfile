pipeline {
  agent any
  environment {
    IMAGE = "your-registry/your-app:${env.BUILD_NUMBER}"
  }
  stages {
    stage('Build') {
      steps { sh 'echo build && mkdir -p build && echo ok > build/result.txt' }
    }
    stage('Test') {
      steps { sh 'pytest -q || true' }
    }
    stage('Build Image') {
      steps { sh 'docker build -t ${IMAGE} .' }
    }
    stage('Push Image') {
      steps { sh 'docker push ${IMAGE}' }
    }
    stage('Update GitOps Manifests') {
      steps {
        script {
          // Update image tag in Git manifests for ArgoCD to sync
          sh '''
            git clone https://github.com/YOUR_ORG/YOUR_GITOPS_REPO.git
            cd YOUR_GITOPS_REPO
            sed -i "s|image:.*|image: ${IMAGE}|" overlays/staging/kustomization.yaml
            git add overlays/staging/kustomization.yaml
            git commit -m "Update staging image to ${IMAGE}"
            git push
          '''
        }
      }
    }
  }
}
