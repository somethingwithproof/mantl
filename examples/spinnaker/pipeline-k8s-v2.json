{
  "application": "example-app",
  "name": "deploy-to-staging",
  "triggers": [
    {"type": "jenkins", "job": "example/job", "master": "Jenkins", "enabled": true}
  ],
  "expectedArtifacts": [
    {
      "defaultArtifact": {},
      "matchArtifact": {"type": "docker/image", "name": "your-registry/your-app"},
      "useDefaultArtifact": false,
      "usePriorArtifact": false
    }
  ],
  "stages": [
    {
      "name": "Deploy manifest",
      "type": "deployManifest",
      "account": "k8s-staging",
      "cloudProvider": "kubernetes",
      "source": "artifact",
      "manifestArtifactId": "",
      "moniker": {"app": "example-app"},
      "skipExpressionEvaluation": false
    },
    { "type": "manualJudgment", "name": "approve-promotion" }
  ]
}
