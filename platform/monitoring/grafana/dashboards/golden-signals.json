{
  "dashboard": {
    "title": "Golden Signals - SRE Metrics",
    "tags": ["mantl", "sre", "golden-signals"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Latency - P50, P95, P99",
        "type": "timeseries",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le, service))",
            "legendFormat": "{{service}} p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le, service))",
            "legendFormat": "{{service}} p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le, service))",
            "legendFormat": "{{service}} p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.5, "color": "yellow"},
                {"value": 1, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Traffic - Requests per Second",
        "type": "timeseries",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{namespace=~\"$namespace\"}[5m])) by (service)",
            "legendFormat": "{{service}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 20,
              "stacking": {"mode": "normal"}
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Errors - Error Rate %",
        "type": "timeseries",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 10},
        "targets": [
          {
            "expr": "(sum(rate(http_requests_total{namespace=~\"$namespace\",code=~\"5..\"}[5m])) by (service) / sum(rate(http_requests_total{namespace=~\"$namespace\"}[5m])) by (service)) * 100",
            "legendFormat": "{{service}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 30
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Saturation - CPU Utilization",
        "type": "timeseries",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 10},
        "targets": [
          {
            "expr": "(sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\"}[5m])) by (pod) / sum(kube_pod_container_resource_limits{namespace=~\"$namespace\",resource=\"cpu\"}) by (pod)) * 100",
            "legendFormat": "{{pod}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Saturation - Memory Utilization",
        "type": "timeseries",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "(sum(container_memory_working_set_bytes{namespace=~\"$namespace\"}) by (pod) / sum(kube_pod_container_resource_limits{namespace=~\"$namespace\",resource=\"memory\"}) by (pod)) * 100",
            "legendFormat": "{{pod}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 80, "color": "yellow"},
                {"value": 95, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Apdex Score (Application Performance Index)",
        "type": "gauge",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "(sum(rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\",le=\"0.5\"}[5m])) + sum(rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\",le=\"2\"}[5m])) / 2) / sum(rate(http_request_duration_seconds_count{namespace=~\"$namespace\"}[5m]))",
            "legendFormat": "Apdex"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.7, "color": "yellow"},
                {"value": 0.85, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "showThresholdMarkers": true,
          "showThresholdLabels": true
        }
      },
      {
        "id": 7,
        "title": "Request Success Rate (Non-5xx)",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 30},
        "targets": [
          {
            "expr": "(sum(rate(http_requests_total{namespace=~\"$namespace\",code!~\"5..\"}[5m])) / sum(rate(http_requests_total{namespace=~\"$namespace\"}[5m]))) * 100",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 95, "color": "yellow"},
                {"value": 99, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 30},
        "targets": [
          {
            "expr": "sum(http_connections_active{namespace=~\"$namespace\"})",
            "legendFormat": "Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1000, "color": "yellow"},
                {"value": 5000, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Average Request Duration",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 30},
        "targets": [
          {
            "expr": "sum(rate(http_request_duration_seconds_sum{namespace=~\"$namespace\"}[5m])) / sum(rate(http_request_duration_seconds_count{namespace=~\"$namespace\"}[5m]))",
            "legendFormat": "Avg Duration"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.1, "color": "yellow"},
                {"value": 0.5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Pod Restarts (24h)",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 30},
        "targets": [
          {
            "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[24h]))",
            "legendFormat": "Restarts"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 20, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "HTTP Status Codes Distribution",
        "type": "piechart",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "sum by (code) (rate(http_requests_total{namespace=~\"$namespace\"}[5m]))",
            "legendFormat": "{{code}}"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "values": ["value", "percent"]
          }
        }
      },
      {
        "id": 12,
        "title": "Top 10 Slowest Endpoints",
        "type": "table",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 36},
        "targets": [
          {
            "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le, path)))",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "path": "Endpoint",
                "Value": "P95 Latency (s)"
              }
            }
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "namespace",
          "type": "query",
          "query": "label_values(kube_namespace_created, namespace)",
          "current": {"value": "All", "text": "All"},
          "includeAll": true,
          "multi": true
        },
        {
          "name": "service",
          "type": "query",
          "query": "label_values(http_requests_total{namespace=~\"$namespace\"}, service)",
          "includeAll": true,
          "multi": true
        }
      ]
    }
  }
}
