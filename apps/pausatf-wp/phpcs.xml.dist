<?xml version="1.0"?>
<!-- SPDX-License-Identifier: MIT -->
<ruleset name="PAUSATF WordPress Coding Standards">
  <description>WordPress-Core, WordPress-Docs, and WordPress-Extra rules.</description>

  <file>web/app</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/web/wp/*</exclude-pattern>
  <exclude-pattern>*/web/app/uploads/*</exclude-pattern>

  <config name="installed_paths" value="vendor/wp-coding-standards/wpcs"/>
  <arg name="extensions" value="php"/>
  <arg name="colors" value="1"/>
  <arg value="sp"/>

  <rule ref="WordPress-Core"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress-Extra"/>

  <!-- Allow short arrays and modern PHP -->
  <rule ref="Generic.Arrays.DisallowShortArraySyntax" severity="0"/>

  <!-- Security: ensure proper escaping/sanitization -->
  <rule ref="WordPress.Security.EscapeOutput"/>
  <rule ref="WordPress.Security.NonceVerification"/>
</ruleset>
