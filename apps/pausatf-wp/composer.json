{
  "name": "pausatf/website",
  "description": "Composer-managed WordPress project for pausatf.org (Bedrock-style)",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "johnpbloch/wordpress": "^6.7",
    "oscarotero/env": "^2.2",
    "roots/bedrock-autoloader": "^1.0",
    "roots/wp-password-bcrypt": "^1.1",
    "composer/installers": "^2.3"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.11",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "phpunit/phpunit": "^10.5",
    "php-stubs/wordpress-stubs": "^6.7",
    "roave/security-advisories": "dev-latest"
  },
  "repositories": [
    { "type": "composer", "url": "https://wpackagist.org" }
  ],
  "extra": {
    "wordpress-install-dir": "web/wp",
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "web/app/plugins/{$name}/": ["type:wordpress-plugin", "wpackagist-plugin/*"],
      "web/app/themes/{$name}/": ["type:wordpress-theme", "wpackagist-theme/*"]
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"if (!file_exists('.env') && file_exists('.env.example')) copy('.env.example', '.env');\""
    ],
    "lint": [
      "phpcs --standard=phpcs.xml.dist --parallel=4"
    ],
    "lint:fix": [
      "phpcbf --standard=phpcs.xml.dist --parallel=4"
    ],
    "stan": "phpstan analyse"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": true
    },
    "sort-packages": true
  }
}
